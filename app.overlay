/* ==============================================================================
 * File: zephyr_project/app.overlay
 * Mục đích: Ghi đè phần cứng cho bo mạch STM32F746G-Discovery
 * ============================================================================== */

/ {
    aliases {
        can-primary = &can1;
        led-warn = &user_led_1;
    };

    leds {
        compatible = "gpio-leds";
        user_led_1: led_1 {
            gpios = <&gpioi 1 GPIO_ACTIVE_HIGH>;
            label = "User Warning LED (PI1)";
        };
    };

    /* Định nghĩa chân Standby của IC CAN Transceiver ngoài (TJA1050 / SN65HVD230) */
    transceiver {
        compatible = "gpio-leds";
        can_stb: stb_pin {
            gpios = <&gpioi 0 GPIO_ACTIVE_HIGH>;
            label = "CAN Transceiver Standby Control (PI0)";
        };
    };
};

/* Kích hoạt ngoại vi CAN1 (Chân PB8: RX, PB9: TX) */
&can1 {
    pinctrl-0 = <&can1_rx_pb8 &can1_tx_pb9>;
    pinctrl-names = "default";
    status = "okay";
    bitrate = <500000>;
    sample-point = <875>;

    /* Mẹo: Bật thuộc tính 'loopback;' bên dưới nếu muốn tự test trên 1 bo mạch duy nhất */
    /* loopback; */
};
